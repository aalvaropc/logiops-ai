# Copy to .env and fill in. Never commit .env.
# AWS credentials are not stored here: this project authenticates
# via `aws login` (IAM user SSO-style login), no access keys needed.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
LOGIOPS_DB_PATH=data/logiops.sqlite3
# Set to replay for a zero-cost, deterministic local agent demo.
LOGIOPS_AGENT_MODE=bedrock
# Required with LOGIOPS_PUBLIC=1. Generate with: openssl rand -hex 32
# LOGIOPS_ACCESS_TOKEN=
# LOGIOPS_PUBLIC=1
# LOGIOPS_PUBLIC_HOST=d123example.cloudfront.net
